[Unit]
Description=Load the Facebook export tree into the shared database (schema facebook); an unchanged tree is skipped
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/strata-takeout-facebook sync
# Real shared Postgres is opt-in (omarchy_db refuses it otherwise); never set it in a shell profile.
Environment=OMARCHY_DB_LIVE=1
# The accounts come from the job: Environment=STRATA_TAKEOUT_FACEBOOK_ACCOUNTS=id[:label]=tree (a drop-in, not this file)
Nice=10
