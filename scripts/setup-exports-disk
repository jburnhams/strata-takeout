#!/bin/bash
# setup-exports-disk: the 8 TB Seagate as an encrypted (LUKS2) ext4 disk for data exports (Google Takeout etc.) at /srv/exports.
#   sudo DISK_SERIAL=... DISK_MODEL=... setup-exports-disk status|prepare
#   prepare   WIPES the disk (asks you to type the serial). Same scheme as setup-mirror-disk:
#                                     key file on the encrypted root for boot + a passphrase you type as second key slot.
# Doc: README.md (Install)
set -euo pipefail
OWNER=${SUDO_USER:-}; [ -n "$OWNER" ] && [ "$OWNER" != root ] || { echo "run with sudo from your own user" >&2; exit 1; }
HOME_DIR=$(getent passwd "$OWNER" | cut -d: -f6); GRP=$(id -gn "$OWNER")
# The target disk is chosen by serial AND model, so a wrong device name can never be wiped. Required, e.g.:
#   sudo DISK_SERIAL=ABC123 DISK_MODEL=ST8000 scripts/setup-exports-disk prepare      (find them with: lsblk -dno PATH,SERIAL,MODEL)
SERIAL=${DISK_SERIAL:?set DISK_SERIAL (see lsblk -dno PATH,SERIAL,MODEL)}; MODEL_PART=${DISK_MODEL:?set DISK_MODEL (part of the model string)}
DISK=$(lsblk -dnpo PATH,SERIAL | awk -v s="$SERIAL" '$2==s {print $1; exit}')
[ -n "$DISK" ] || { echo "no disk with serial $SERIAL" >&2; exit 1; }
NAME=exports; MP=/srv/exports; FSTAB=/etc/fstab
KEY=/etc/cryptsetup-keys.d/$NAME.key

case "${1:-help}" in
status)
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MODEL,SERIAL,MOUNTPOINTS "$DISK" 2>&1 || true
  cryptsetup status $NAME 2>&1 | head -4; findmnt "$MP" || echo "$MP not mounted" ;;
prepare)
  [ -e "$DISK" ] || { echo "disk $DISK not found" >&2; exit 1; }
  DEV=$(readlink -f "$DISK"); echo "Target: $DEV"
  [ "$(lsblk -dn -o SERIAL "$DEV" | tr -d ' ')" = "$SERIAL" ] || { echo "serial mismatch, refusing" >&2; exit 1; }
  lsblk -dn -o MODEL "$DEV" | grep -q "$MODEL_PART" || { echo "model mismatch, refusing" >&2; exit 1; }
  if lsblk -rn -o MOUNTPOINTS "$DEV" | grep -q .; then echo "a partition of $DEV is mounted; unmount it first" >&2; exit 1; fi
  if findmnt -n "$MP" >/dev/null; then echo "$MP is already mounted: prepare was done" >&2; exit 1; fi
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MODEL,SERIAL "$DEV"
  echo; echo "EVERYTHING on this disk (BitLocker volume etc.) will be destroyed."
  read -r -p "Type WIPE $SERIAL to continue: " ans; [ "$ans" = "WIPE $SERIAL" ] || { echo aborted; exit 1; }
  cp "$FSTAB" "$FSTAB.bak.exports"
  for p in $(lsblk -rn -o PATH "$DEV" | tail -n +2); do wipefs -a "$p" >/dev/null; done
  wipefs -a "$DEV" >/dev/null
  echo 'label: gpt' | sfdisk --quiet "$DEV"; echo ',,L' | sfdisk --quiet --append "$DEV"
  partprobe "$DEV"; udevadm settle; sleep 2
  PART=$(lsblk -rn -o PATH "$DEV" | tail -n +2 | head -1); echo "Partition: $PART"
  install -d -m 700 /etc/cryptsetup-keys.d
  [ -e "$KEY" ] || { umask 077; dd if=/dev/urandom of="$KEY" bs=64 count=1 status=none; }
  chmod 400 "$KEY"
  cryptsetup luksFormat --type luks2 --batch-mode --label exports-crypt --key-file "$KEY" "$PART"
  echo; echo "Set the passphrase for this disk (same one as your other encrypted disks); you type it twice:"
  cryptsetup luksAddKey --key-file "$KEY" "$PART"
  cryptsetup open --key-file "$KEY" "$PART" $NAME
  mkfs.ext4 -q -F -L $NAME -m 0 /dev/mapper/$NAME
  LUKSUUID=$(blkid -s UUID -o value "$PART")
  cp -n /etc/crypttab /etc/crypttab.bak.exports 2>/dev/null || true
  grep -q "^$NAME " /etc/crypttab 2>/dev/null || echo "$NAME UUID=$LUKSUUID $KEY luks,nofail,x-systemd.device-timeout=15s" >> /etc/crypttab
  grep -q " $MP " "$FSTAB" || echo "/dev/mapper/$NAME $MP ext4 defaults,noatime,nofail,x-systemd.device-timeout=15s 0 2" >> "$FSTAB"
  HB=$HOME_DIR/data/luks-header-$NAME.img; rm -f "$HB"
  if cryptsetup luksHeaderBackup "$PART" --header-backup-file "$HB" 2>/dev/null; then chown "$OWNER:$GRP" "$HB"; echo "LUKS header backup: $HB"
  else cryptsetup luksHeaderBackup "$PART" --header-backup-file /root/luks-header-$NAME.img; echo "LUKS header backup: /root/luks-header-$NAME.img (copy it off this disk)"; fi
  install -d "$MP"; systemctl daemon-reload; mount "$MP"
  chown "$OWNER:$GRP" "$MP"
  install -d -o "$OWNER" -g "$GRP" "$MP/google-takeout"
  ln -sfn "$MP" "$HOME_DIR/exports"; chown -h "$OWNER:$GRP" "$HOME_DIR/exports"
  df -h "$MP" | tail -1
  echo; echo "Prepared: $MP (also ~/exports). Drop archives in $MP/<service>/." ;;
*) sed -n 2,7p "$0" ;;
esac
