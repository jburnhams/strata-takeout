[Unit]
Description=Load Google chat exports (Takeout Google Chat folder, Gmail chat logs, gmvault backups) into the shared database (schema googlechat); an unchanged tree is skipped
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/strata-takeout-googlechat sync
# Real shared Postgres is opt-in (omarchy_db refuses it otherwise); never set it in a shell profile.
Environment=OMARCHY_DB_LIVE=1
# The accounts come from the job: Environment=STRATA_TAKEOUT_GOOGLECHAT_ACCOUNTS=id[:label]=path[;path...] (a drop-in, not this file)
Nice=10
