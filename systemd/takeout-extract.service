[Unit]
Description=Extract finished Google Takeout archives (oldest first), move them to done/
OnFailure=notify-failure@%n.service
# a finished extract may bring new YouTube history or a new Facebook, Instagram or Google chat export
OnSuccess=takeout-youtube.service takeout-facebook.service takeout-instagram.service takeout-googlechat.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/takeout-extract
Nice=10
TimeoutStartSec=infinity
