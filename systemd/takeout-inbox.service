[Unit]
Description=Ingest export archives dropped into the takeouts inbox (extract, catalogue, file the zip)
OnFailure=notify-failure@%n.service
# a finished extract may bring new YouTube history
OnSuccess=takeout-youtube.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/strata-takeout-inbox
Nice=10
TimeoutStartSec=infinity
