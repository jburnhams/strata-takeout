#!/bin/bash
# takeout-pull: move finished Google Takeout files from Drive to local disks, deleting them from Drive.
#   takeout-pull [--files] [--dry-run]     (default: archives; --files: the non-archives)
# Drive "Takeout" folder (remote gdrive:, full-drive scope) is split in two independent jobs (own lock, own systemd unit/timer),
# so a few huge videos never hold up the zips; total parallel transfers = FILE_TRANSFERS (1) + TRANSFERS (2) = 3:
#   --files: non-archives (.mp4, .mbox, ...)  -> straight to the exports disk: /srv/exports/google-takeout/loose/
#   default: archives (.zip .tgz .tar)  -> staged on the NVMe in $STAGE (~/.cache/takeout-stage: outside restic, not tmpfs),
#      in batches of BATCH (soft cutoff) and only while the stage holds less than STAGE_MAX GB. takeout-extract (own timer)
#      extracts them oldest export first onto the exports disk and moves each archive to done/, which frees the stage.
# `rclone move` deletes each Drive file only after the copy is verified (size + hash); --drive-use-trash=false so the space
# is freed on Drive at once. Files younger than MIN_AGE are skipped (Takeout may still be writing them).
# Doc: README.md and docs/platforms.md
set -uo pipefail
REMOTE=${TAKEOUT_REMOTE:-gdrive:Takeout}
ROOT=${EXPORTS_ROOT:-/srv/exports}/google-takeout
STAGE=${STAGE:-$HOME/.cache/takeout-stage}
STAGE_MAX=${STAGE_MAX:-300}      # GB of archives allowed on the stage before pausing downloads
MIN_FREE_GB=${MIN_FREE_GB:-400}  # downloads also pause while the filesystem holding the stage has less than this free (finished zips are kept next to it)
NTFY_SEND=${NTFY_SEND:-$HOME/.local/bin/ntfy-send}
BATCH=${BATCH:-100G}
MIN_AGE=${MIN_AGE:-10m}
MODE=archives; DRY=()
for a in "$@"; do case "$a" in --files) MODE=files;; --dry-run) DRY=(--dry-run);; *) echo "usage: takeout-pull [--files] [--dry-run]" >&2; exit 2;; esac; done
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/takeout-pull-$MODE.lock"
flock -n 9 || { echo "takeout-pull already running"; exit 0; }
if [ -z "${EXPORTS_ROOT:-}" ] && ! mountpoint -q /srv/exports; then echo "/srv/exports is not mounted" >&2; exit 1; fi
[[ $REMOTE == *:* ]] && { rclone lsd "${REMOTE%%:*}:" >/dev/null 2>&1 || { echo "rclone remote ${REMOTE%%:*}: not configured or auth failed" >&2; exit 1; }; }
if ! rclone lsf "$REMOTE" >/dev/null 2>&1; then echo "no $REMOTE folder on Drive: nothing to do"; exit 0; fi
mkdir -p "$ROOT/loose" "$STAGE"
ARCH=(--include '*.zip' --include '*.tgz' --include '*.tar.gz' --include '*.tar')
NOARCH=(--exclude '*.zip' --exclude '*.tgz' --exclude '*.tar.gz' --exclude '*.tar')
DUPES=$(mktemp); trap 'rm -f "$DUPES"' EXIT
# rclone logs one line per same-named duplicate on Drive (they are skipped and stay on Drive); keep them out of the journal (and alert text), count them instead
rc_move() { rclone move "$@" 2> >(tee -a "$DUPES" | grep -v 'Duplicate object found' >&2); local r=$?; wait; return $r; }
XFERS=${FILE_TRANSFERS:-1}; [ "$MODE" = archives ] && XFERS=${TRANSFERS:-2}
COMMON=(--min-age "$MIN_AGE" --drive-use-trash=false --drive-acknowledge-abuse --order-by name,ascending
        --transfers "$XFERS" --checkers 4 --retries 5 --low-level-retries 20 --delete-empty-src-dirs
        --stats 5m --stats-one-line --log-level NOTICE "${DRY[@]}")
rc=0
# Drive allows several files with the same name and rclone would skip them all. Rename them apart first (name-1.zip, name-2.zip: only
# names on Drive change; byte-identical twins are removed, different ones are kept) and note them in $ROOT/dupes.tsv so takeout-extract
# waits for all twins and extracts them oldest-modified first (rclone numbers the NEWER file -1).
dedupe_names() {
  local f=("${ARCH[@]}"); [ "$MODE" = files ] && f=("${NOARCH[@]}")
  rclone dedupe --dedupe-mode rename --min-age "$MIN_AGE" --drive-use-trash=false "${f[@]}" "${DRY[@]}" "$REMOTE" 2>&1 \
    | sed -n 's/^.*\(NOTICE\|INFO\|INFO+2\): \(.*\): Found \([0-9][0-9]*\) files with duplicate names$/\2\t\3/p' | sort -u \
    | while IFS=$'\t' read -r n k; do
        [ ${#DRY[@]} -gt 0 ] && { echo "would rename $k twins of $n"; continue; }
        grep -qxF "$n"$'\t'"$k" "$ROOT/dupes.tsv" 2>/dev/null || { printf '%s\t%s\n' "$n" "$k" >> "$ROOT/dupes.tsv"; echo "renamed $k same-named files on Drive: $n"; }
      done
}
dedupe_names
if [ "$MODE" = files ]; then
  echo "non-archives -> $ROOT/loose ($XFERS transfer(s))"
  rc_move "$REMOTE" "$ROOT/loose" "${NOARCH[@]}" "${COMMON[@]}" || { echo "rclone move (non-archives) failed" >&2; rc=1; }
else
  used=$(( $(du -sb "$STAGE" | cut -f1) / 1000000000 ))
  free=$(df -B1000000000 --output=avail "$STAGE" | tail -1 | tr -d ' ')
  if [ "$free" -lt "$MIN_FREE_GB" ]; then
    echo "only ${free} GB free where the stage lives (< MIN_FREE_GB=$MIN_FREE_GB): downloads paused until zips are deleted or moved"
    # one push per 6 hours, so a paused pipeline is noticed without a flood
    mark="${XDG_STATE_HOME:-$HOME/.local/state}/strata-takeout/lowspace.notified"; mkdir -p "$(dirname "$mark")"
    if [ -z "$(find "$mark" -mmin -360 2>/dev/null)" ]; then
      "$NTFY_SEND" "Takeout downloads paused: disk almost full" "Only ${free} GB free where the stage and finished zips live (floor ${MIN_FREE_GB} GB). Delete verified zips from done/ to resume." high warning 2>/dev/null; touch "$mark"
    fi
  elif [ "$used" -ge "$STAGE_MAX" ]; then
    echo "stage holds ${used} GB (>= $STAGE_MAX): waiting for takeout-extract to drain it"
  else
    echo "archives -> $STAGE (stage ${used} GB, batch $BATCH, $XFERS transfers)"
    rc_move "$REMOTE" "$STAGE" "${ARCH[@]}" --max-transfer "$BATCH" --cutoff-mode soft "${COMMON[@]}"
    r=$?; [ $r = 0 ] || [ $r = 8 ] || { echo "rclone move (archives) failed rc=$r" >&2; rc=1; }   # 8 = batch limit reached: normal
  fi
fi
nd=$(grep -o "[^ ]*: Duplicate object found" "$DUPES" | sort -u | wc -l); [ "$nd" -gt 0 ] && echo "$nd same-named duplicate file(s) on Drive skipped (still there): rclone dedupe --dedupe-mode list $REMOTE"
[ $rc = 0 ] && echo "takeout-pull ($MODE) ok $(date -Is)"
exit $rc
